<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="zaber_ros2_control" params="name
						 prefix
						 com_port:=/dev/ttyUSB0">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>zaber_driver/ZaberSystemHardwareInterface</plugin>
        <param name="com_port">${com_port}</param>
      </hardware>
      
      <joint name="${prefix}horizontal_joint">
        <command_interface name="position">
          <param name="min">-0.05</param>
          <param name="max"> 0.05</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-0.01</param>
          <param name="max"> 0.01</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>
      
      <joint name="${prefix}insertion_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.1</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-0.01</param>
          <param name="max"> 0.01</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>
      
      <joint name="${prefix}vertical_joint">
        <command_interface name="position">
          <param name="min">-0.05</param>
          <param name="max"> 0.05</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-0.01</param>
          <param name="max"> 0.01</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>

    </ros2_control>

    
  </xacro:macro>
</robot>
